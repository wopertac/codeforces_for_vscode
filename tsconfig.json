{
    "compilerOptions": {
        "module": "NodeNext",
        "target": "ES2022",
        "moduleResolution": "NodeNext",
        "rootDir": "./src",
        "outDir": "./out",
        "lib": ["ES2022", "DOM"],
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/**/*"]
}