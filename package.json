{
	"name": "srpo3",
	"displayName": "srpo3",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "srpo3-sidebar-view",
					"title": "SRPO3",
					"icon": "resources/icon2.png"
				}
			]
		},
		"views": {
			"srpo3-sidebar-view": [
				{
					"id": "srpo3-container",
					"name": "SRPO3",
					"icon": "resources/icon2.png"
				}
			]
		},
		"commands": [
			{
				"command": "srpo3.loginCF",
				"title": "CF : Авторизоваться (Логин/Пароль)"
			},
			{
				"command": "srpo3.logoutCF",
				"title": "CF : Выйти из аккаунта"
			}
		]
	},
	"description": "",
	"keywords": [],
	"type": "commonjs",
	"devDependencies": {
		"@types/node": "^22.20.2",
		"@types/vscode": "^1.137.0",
		"puppeteer": "^25.10.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"puppeteer-core": "^25.10.0",
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2"
	}
}
